{
  "name": "player-web",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "apps/player-web/src",
  "projectType": "application",
  "tags": ["scope:player", "type:app"],
  "implicitDependencies": ["player-ui", "player-infrastructure"],
  "targets": {
    "serve": {
      "executor": "nx:run-commands",
      "options": {
        "command": "npx vite",
        "cwd": "{projectRoot}"
      }
    },
    "build": {
      "executor": "nx:run-commands",
      "outputs": ["{workspaceRoot}/dist/apps/player-web"],
      "options": {
        "command": "npx vue-tsc --noEmit && npx vite build",
        "cwd": "{projectRoot}"
      }
    },
    "preview": {
      "executor": "nx:run-commands",
      "options": {
        "command": "npx vite preview",
        "cwd": "{projectRoot}"
      }
    },
    "typecheck": {
      "executor": "nx:run-commands",
      "options": {
        "command": "npx vue-tsc --noEmit",
        "cwd": "{projectRoot}"
      }
    }
  }
}
