    "vue-router": "catalog:"
  },
  "devDependencies": {
    "@biomejs/biome": "catalog:",
    "@nx/js": "catalog:",
    "@nx/vite": "catalog:",
    "@nx/vue": "catalog:",
    "@nx/web": "catalog:",
    "@stryker-mutator/core": "catalog:",
    "@stryker-mutator/vitest-runner": "catalog:",
    "@swc/helpers": "catalog:",
    "@types/node": "catalog:",
    "@vitejs/plugin-vue": "catalog:",
    "@vue/test-utils": "catalog:",
    "esbuild": "catalog:",
    "jiti": "catalog:",
    "nx": "catalog:",
    "tsx": "catalog:",
    "typescript": "catalog:",
    "vite": "catalog:",
    "vitest": "catalog:",
    "vue-tsc": "catalog:"
  }
}
