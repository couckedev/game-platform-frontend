{
  "name": "game-platform-frontend-modulith",
  "private": true,
  "type": "module",
  "scripts": {
    "lint": "biome check .",
    "lint:fix": "biome check . --write --unsafe",
    "format": "biome format . --write",
    "clean:hard": "find . \\( -name dist -o -name node_modules -o -name .nx \\) -type d -prune -exec rm -rf {} +"
  },
  "engines": {
    "node": ">=22",
    "pnpm": ">=9"
  },
  "packageManager": "pnpm@9.12.0",
  "dependencies": {
