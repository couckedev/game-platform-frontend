{
  "name": "game-platform-frontend",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "pnpm nx run-many --target=build",
    "test:unit": "pnpm nx run-many --target=test:unit",
    "dev": "pnpm nx run frontend:serve",
    "lint": "pnpm nx run-many --target=lint",
    "format": "prettier --write .",
    "changeset": "changeset",
    "version-packages": "changeset version"
  },
  "devDependencies": {
    "@changesets/cli": "^2.31.0",
    "@nx/eslint": "19.8.14",
    "@nx/js": "19.8.14",
    "@types/node": "^25.6.0",
    "@typescript-eslint/eslint-plugin": "^8.60.0",
    "@typescript-eslint/parser": "^8.60.0",
    "eslint": "^9.39.4",
    "eslint-import-resolver-typescript": "^4.4.5",
    "eslint-plugin-boundaries": "^5.4.0",
    "eslint-plugin-import": "^2.32.0",
    "nx": "19.8.14",
    "prettier": "^3.8.3",
    "typescript": "^6.0.3"
  },
  "engines": {
    "node": ">=24",
    "pnpm": ">=9"
  },
  "pnpm": {
    "overrides": {
      "vite": "^6.3.0"
    }
  },
  "packageManager": "pnpm@9.12.0",
  "dependencies": {
    "@iconify-vue/flat-color-icons": "^1.0.3",
    "axios": "^1.17.0",
    "pinia": "^3.0.0",
    "vitest": "^4.1.8"
  }
