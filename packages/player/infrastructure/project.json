{
  "name": "player-infrastructure",
  "$schema": "../../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "packages/player/infrastructure/src",
  "projectType": "library",
  "tags": ["type:infrastructure", "scope:player"],
  "implicitDependencies": [
    "player-domain",
    "player-application",
    "player-interface-adapters",
    "shared-infrastructure"
  ],
  "targets": {
    "test:integration": {
      "executor": "nx:run-commands",
      "options": {
        "command": "vitest run",
        "cwd": "{projectRoot}"
      }
    },
    "build": {
      "executor": "nx:run-commands",
      "outputs": ["{workspaceRoot}/dist/packages/player/infrastructure"],
      "options": {
        "command": "npx tsc -p packages/player/infrastructure/tsconfig.lib.json"
      }
    },

    "database:generate": {
      "executor": "nx:run-commands",
      "options": {
        "command": "drizzle-kit generate --config src/database/drizzle.config.ts",
        "cwd": "{projectRoot}"
      }
    },
    "database:migrate": {
      "executor": "nx:run-commands",
      "options": {
        "command": "drizzle-kit migrate --config src/database/drizzle.config.ts",
        "cwd": "{projectRoot}"
      }
    },
    "test": {
      "executor": "nx:run-commands",
      "options": {
        "command": "vitest run",
        "cwd": "{projectRoot}"
      }
    }
  }
}
