{
  "name": "player-infrastructure",
  "$schema": "../../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "packages/player/infrastructure/src",
  "projectType": "library",
  "targets": {
    "test": {
      "executor": "nx:run-commands",
      "options": {
        "command": "vitest run",
        "cwd": "{projectRoot}"
      }
    },
    "build": {
      "executor": "@nx/js:tsc",
      "outputs": ["{projectRoot}/dist"],
      "options": {
        "outputPath": "packages/player/infrastructure/dist",
        "main": "packages/player/infrastructure/src/index.ts",
        "tsConfig": "packages/player/infrastructure/tsconfig.build.json",
        "rootDir": "packages/player/infrastructure/src",
        "assets": []
      }
    }
  },
  "tags": ["type:library"]
}
