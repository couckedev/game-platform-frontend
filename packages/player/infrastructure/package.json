{
  "name": "@player/infrastructure",
  "version": "0.0.1",
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "private": true,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./adapters": {
      "types": "./dist/adapters/index.d.ts",
      "import": "./dist/adapters/index.js"
    },
    "./cucumber": {
      "types": "./dist/cucumber/index.d.ts",
      "import": "./dist/cucumber/index.js"
    },
    "./http": {
      "types": "./dist/http/index.d.ts",
      "import": "./dist/http/index.js"
    }
  },
  "dependencies": {
    "@player/interface-adapters": "workspace:*",
    "@shared/infrastructure": "workspace:*",
    "inversify": "^8.1.1"
  },
  "devDependencies": {
    "@types/axios": "^0.14.4",
    "axios": "catalog:",
    "pinia": "catalog:"
  }
