{
  "name": "@player/infrastructure",
  "version": "0.0.1",
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "private": true,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./adapters": {
      "types": "./dist/adapters/index.d.ts",
      "import": "./dist/adapters/index.js"
    },
    "./stores": {
      "types": "./dist/stores/index.d.ts",
      "import": "./dist/stores/index.js"
    }
  },
  "dependencies": {
    "@player/domain": "workspace:*",
    "@player/application": "workspace:*",
    "pinia": "catalog:",
    "@couckedev/cqrs-core": "catalog:"
  }
}
