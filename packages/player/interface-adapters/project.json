{
  "name": "player-interface-adapters",
  "$schema": "../../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "packages/player/interface-adapters/src",
  "projectType": "library",
  "tags": ["type:interface-adapters", "scope:player"],
  "implicitDependencies": ["player-application"],
  "targets": {
    "test": {
      "executor": "nx:run-commands",
      "options": {
        "command": "npx vitest run",
        "cwd": "{projectRoot}"
      }
    },
    "build": {
      "executor": "nx:run-commands",
      "outputs": ["{workspaceRoot}/dist/packages/player/interface-adapters"],
      "options": {
        "command": "npx tsc -p packages/player/interface-adapters/tsconfig.lib.json"
      }
    }
  }
}