{
  "name": "@shared/ui",
  "private": true,
  "type": "module",
  "exports": {
    "./forms/*": {
      "import": "./src/forms/*/index.ts"
    },
    "./design-system/*": {
      "import": "./src/design-system/*/index.ts"
    },
    "./design-system/foundations": {
      "style": "./src/design-system/foundations/index.css"
    },
    "./stores/*": {
      "import": "./src/stores/*/index.ts"
    },
    "./authentication/*": {
      "import": "./src/authentication/*/index.ts"
    },
    "./http/*": {
      "import": "./src/http/*/index.ts"
    },
    "./composition/*": {
      "import": "./src/composition/*/index.ts"
    }
  },
  "dependencies": {
    "@shared/infrastructure": "workspace:*",
    "vue": "catalog:",
    "vue-router": "catalog:",
    "pinia": "catalog:",
    "vee-validate": "^4.15.1",
    "@fontsource/inter": "^5.2.8",
    "@fontsource/manrope": "^5.2.8",
    "@headlessui/vue": "catalog:",
    "class-variance-authority": "^0.7.1",
    "lucide-vue-next": "^1.0.0",
    "tailwind-merge": "^3.6.0"
  }
}
